# Copy this file to .env and fill in ONE provider's key. If you leave all keys
# blank, the app runs in mock mode automatically (fake replies, no key needed,
# good for trying the screens and the orchestrator rules).

# --- Option A: Google Gemini, FREE tier, no credit card needed ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Force a specific provider instead of auto-detecting from the keys above:
# mock | gemini
PROVIDER=

# Force mock mode regardless of any keys set above (1 = on). Ignored if
# PROVIDER is set.
MOCK=0

# --- Agents (1 = on, 0 = off). Turn one off to compare the app with and
# without it, or to save free-tier calls.
# AGENT_PLANNER: Planner agent picks the next move (rules still guard it)
# AGENT_TOOLS:   Tutor agent may run small quant simulations
# AGENT_CHECKER: Checker agent reviews each tutor reply before it is shown
AGENT_PLANNER=1
AGENT_TOOLS=1
AGENT_CHECKER=1

# --- Daily limit of AI calls (see app/limits.py) ---
# New sessions stop at this many calls a day, so sessions already running can
# finish inside Gemini's free 500 a day. 0 = no limit (for a paid key).
DAILY_CALL_BUDGET=400

# --- Study mode for the research project (off when blank) ---
# The participant codes the lecturer hands out, separated by commas. When set,
# the app first shows a consent screen, only these codes can start a session,
# and each session is saved with its code (no names). Only switch it on after
# the supervisor and the ethics approval agree.
STUDY_CODES=

# --- Saving online (only needed when deployed, e.g. on Render) ---
# Free hosts wipe their files on restart, so sessions and transcripts go to a
# free Supabase database instead. Leave both blank to save to files locally.
# Set up the tables once with deploy/supabase.sql. Never share the secret key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
