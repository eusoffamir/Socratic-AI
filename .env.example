# Copy this file to .env and fill in ONE provider's key. If you leave all keys
# blank, the app runs in mock mode automatically (fake replies, no key needed,
# good for trying the screens and the orchestrator rules).

# --- Option A: Google Gemini, FREE tier, no credit card needed ---
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Option B: Anthropic Claude, paid ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Force a specific provider instead of auto-detecting from the keys above:
# mock | gemini | anthropic
PROVIDER=

# Force mock mode regardless of any keys set above (1 = on). Ignored if
# PROVIDER is set.
MOCK=0

# --- Agents (1 = on, 0 = off). Turn one off to compare the app with and
# without it, or to save free-tier calls.
# AGENT_PLANNER: Planner agent picks the next move (rules still guard it)
# AGENT_TOOLS:   Tutor agent may run small quant simulations
# AGENT_CHECKER: Checker agent reviews each tutor reply before it is shown
AGENT_PLANNER=1
AGENT_TOOLS=1
AGENT_CHECKER=1
